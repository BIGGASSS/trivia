{
  "name": "trivia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "run-s --npm-path pnpm build:map type-check \"build-only {@}\" --",
    "preview": "vp preview",
    "test:unit": "vp test",
    "test:browser": "vp run build && playwright test",
    "build-only": "vp build",
    "build:map": "node scripts/build-country-paths.ts",
    "type-check": "vue-tsc --build",
    "lint": "vp lint . --fix",
    "format": "vp fmt . --write"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "vue": "^3.5.32",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tsconfig/node26": "^26.0.1",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.2",
    "npm-run-all2": "^8.0.4",
    "typescript": "~6.0.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue-tsc": "^3.2.6"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.8.2",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=26.8.2"
  }
}
